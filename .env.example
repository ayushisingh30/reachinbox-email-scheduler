# =============================================================================
# ReachInbox Email Job Scheduler - example environment
#
# Copy to backend/.env (the backend also reads a .env in the repo root as a
# fallback) and fill in the blanks. NEVER commit the filled-in file.
# =============================================================================

NODE_ENV=development
PORT=5000

# Public URLs. FRONTEND_URL is where OAuth sends the browser after login and is
# automatically added to the CORS allow-list.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Optional extra browser origins, comma separated.
CORS_ORIGINS=

# --- PostgreSQL --------------------------------------------------------------
# Local Docker (docker compose up -d):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
# Hosted example (Neon):
# DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Redis (BullMQ) ----------------------------------------------------------
# Local Docker or the bundled redis/redis-server.exe:
REDIS_URL=redis://127.0.0.1:6379
# Hosted example (Upstash TCP endpoint - the REST URL will NOT work with BullMQ):
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# --- Session cookie ----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_TTL_DAYS=7
# Leave the next three unset locally; in production they default to none/true.
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=

# --- Google OAuth 2.0 --------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# GOOGLE_CALLBACK_URL must be listed verbatim under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# --- SMTP (Ethereal) ---------------------------------------------------------
# Create a free inbox at https://ethereal.email/create
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
ETHEREAL_FROM_NAME=ReachInbox

# Additional senders (optional). Point a Sender row at credentialRef "TEAM_B":
# SMTP_CRED_TEAM_B_USER=
# SMTP_CRED_TEAM_B_PASSWORD=
# SMTP_CRED_TEAM_B_HOST=smtp.ethereal.email
# SMTP_CRED_TEAM_B_PORT=587

# --- Scheduler ---------------------------------------------------------------
WORKER_CONCURRENCY=5
DEFAULT_MIN_SEND_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=100
# Hard floor the worker enforces even if a campaign asks for less.
MIN_SEND_DELAY_FLOOR_MS=250
# How long a worker may hold an email before another worker may take it over.
PROCESSING_LEASE_MS=60000
# Spacing waits above this are re-queued instead of slept on.
MAX_INLINE_SPACING_WAIT_MS=10000
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# --- Limits ------------------------------------------------------------------
MAX_RECIPIENTS_PER_CAMPAIGN=10000
MAX_UPLOAD_BYTES=5242880

LOG_LEVEL=info
